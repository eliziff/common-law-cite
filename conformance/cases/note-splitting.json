{
  "format": "legal-citations-conformance:v1",
  "source": "Independently invented notes. The note splitter (quoteCitationUnits) takes a part's kind from the citations the finder reads and never cuts inside one.",
  "cases": [
    {
      "name": "charter-is-one-statute-part",
      "method": "quoteCitationUnits",
      "status": "pass",
      "request": {
        "texts": [
          "Part I of the Constitution Act, 1982, being Schedule B to the Canada Act 1982 (UK), 1982, c 11 [Charter]."
        ]
      },
      "expect": [
        {
          "parts": [
            {
              "fields": {
                "kind": "statute"
              }
            }
          ]
        }
      ]
    },
